# Otro Supabase en vez del de doro.page (el de doro.page ya viene en Supabase.js).
# Copiar a `.env` y completar.
# `scripts/instalar-local.sh` lo copia junto al plugin; ~/.config/doro/supabase.json lo reemplaza.
#
# Supabase → Project Settings → API (o Data API):
#   - Project URL
#   - la clave anon / publishable (pública: es la misma que usa la web).
# NUNCA la service_role ni la secret key: el plugin corre en la máquina de cada usuario.
DORO_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
DORO_SUPABASE_ANON_KEY=<clave-anon>
