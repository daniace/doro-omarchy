# Another Supabase instead of doro.page's (doro.page's already ships in Supabase.js).
# Copy to `.env` and fill in.
# `scripts/instalar-local.sh` copies it next to the plugin; ~/.config/doro/supabase.json overrides it.
#
# Supabase → Project Settings → API (or Data API):
#   - Project URL
#   - the anon / publishable key (public: the same one the web uses).
# NEVER the service_role or secret key: the plugin runs on each user's machine.
DORO_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
DORO_SUPABASE_ANON_KEY=<clave-anon>
